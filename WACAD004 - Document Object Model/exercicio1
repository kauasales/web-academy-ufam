<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Carrinho de Compra</title>
  </head>  
  <body>
    <div id="resumo-carrinho">
      <h2>Fechamento do Pedido</h2>
      
      <label>Subtotal dos Produtos (R$):</label>
      <input type="number" id="valor-subtotal" value="150.00">
      <br><br>

      <label>Valor do Frete (R$):</label>
      <input type="number" id="valor-frete" value="25.50">
      <br><br>

      <h3>Itens na sua caixa:</h3>
      <ul id="lista-produtos">
        <li class="produto-comprado">Camiseta Básica Preta</li>
        <li class="produto-comprado">Calça Jeans Tradicional</li>
        <li class="produto-comprado">Par de Meias Brancas</li>
      </ul>
    </div>

    <script>
      const listaProdutos = document.getElementById('lista-produtos');
      const itensProdutos = listaProdutos.getElementsByClassName('produto-comprado');
      const quantidadeItens = itensProdutos.length;

      const subtotalInput = document.getElementById('valor-subtotal');
      const freteInput = document.getElementById('valor-frete');

      const subtotal = parseFloat(subtotalInput.value);
      const frete = parseFloat(freteInput.value);
      const total = subtotal + frete;

      console.log(`Quantidade de itens: ${quantidadeItens}`);
      console.log(`Subtotal: R$ ${subtotal.toFixed(2)}`);
      console.log(`Frete: R$ ${frete.toFixed(2)}`);
      console.log(`Total da compra: R$ ${total.toFixed(2)}`);
    </script>
  </body>
</html>
