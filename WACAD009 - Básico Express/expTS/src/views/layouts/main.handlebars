<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">

    <title>Express + Handlebars</title>

    <link
        href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
        rel="stylesheet"
    >

    <link rel="stylesheet" href="/css/style.css">
</head>
<body>

    <nav class="navbar navbar-expand-lg navbar-dark bg-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/">Express MVC</a>

            <button
                class="navbar-toggler"
                type="button"
                data-bs-toggle="collapse"
                data-bs-target="#navbarNav"
            >
                <span class="navbar-toggler-icon"></span>
            </button>

            <div class="collapse navbar-collapse" id="navbarNav">
                <div class="navbar-nav">

                    <a class="nav-link {{isActive currentPath '/'}}" href="/">Home</a>

                    <a class="nav-link {{isActive currentPath '/hb1'}}" href="/hb1">HB1</a>

                    <a class="nav-link {{isActive currentPath '/hb2'}}" href="/hb2">HB2</a>

                    <a class="nav-link {{isActive currentPath '/hb3'}}" href="/hb3">HB3</a>

                    <a class="nav-link {{isActive currentPath '/hb4'}}" href="/hb4">HB4</a>

                    <a class="nav-link {{startsWith currentPath '/lorem/1'}}" href="/lorem/1">Lorem</a>

                    <a class="nav-link {{startsWith currentPath '/lorem/10'}}" href="/lorem/10">Lorem 10</a>

                    <a class="nav-link {{startsWith currentPath '/products'}}" href="/products">Produtos</a>

                </div>
            </div>
        </div>
    </nav>

    <div class="container mt-4">
        {{{body}}}
    </div>

    <script
        src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js">
    </script>

</body>
</html>