<h1>Novo Produto</h1>

<form action="/products/create" method="POST">

    <div class="mb-3">
        <label>Nome</label>
        <input
          type="text"
          name="name"
          class="form-control"
          required
        >
    </div>

    <div class="mb-3">
        <label>Preço</label>
        <input
          type="number"
          step="0.01"
          name="price"
          class="form-control"
          required
        >
    </div>

    <button class="btn btn-primary">
      Salvar
    </button>

</form>